{
  "name": "flashpoint-launcher",
  "version": "14.0.3",
  "description": "A desktop application used to browse, manage and play games from Flashpoint Archive",
  "main": "build/main/index.js",
  "config": {
    "cacheKey": 3,
    "forceUpdate": 1,
    "installed": false
  },
  "author": {
    "name": "Jesper Gustafsson",
    "email": "jespergustafssons@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "launch": "node tools/launch.js --foreground",
    "smoke": "node tools/launch.js --smoke",
    "bootstrap:flashpoint": "node tools/bootstrap-flashpoint.js",
    "discover:launch-scenes": "node tools/discover-launch-scenes.js",
    "doctor:flashpoint": "node tools/doctor-flashpoint.js",
    "inventory:sources": "node tools/inventory-sources.js",
    "audit:audio-assets": "node tools/audit-audio-assets.js",
    "audit:as2-sound-calls": "node tools/audit-as2-sound-calls.js",
    "audit:sound-refs": "node tools/audit-sound-references.js",
    "extract:text": "node tools/extract-text.js",
    "generate:as3-logos": "node tools/generate-as3-logo-overrides.js",
    "translate:pack": "node tools/translate-pack.js",
    "patch:pack": "node tools/patch-pack.js",
    "rebuild:runtime-zip": "node tools/rebuild-runtime-zip.js",
    "rebuild:pack": "node tools/rebuild-pack.js",
    "verify:pack-inputs": "node tools/verify-pack-runtime-inputs.js",
    "as3:full-localize": "node tools/as3-full-localize.js",
    "qa:window-audit": "node tools/window-audit.js",
    "qa:capture": "node tools/qa-capture.js",
    "qa:ocr": "node tools/qa-ocr.js",
    "qa:audio-check": "node tools/qa-audio-check.js",
    "qa:validate-as3": "node tools/qa-validate-runtime.js --source as3",
    "qa:validate-as2": "node tools/qa-validate-runtime.js --source as2",
    "qa:as2-sound-bridge": "node tools/qa-as2-sound-bridge.js",
    "qa:as2-launch-smoke": "node tools/qa-as2-launch-smoke.js",
    "qa:as3-launch-smoke": "node tools/qa-as3-launch-smoke.js",
    "qa:as3-islands-smoke": "node tools/qa-as3-islands-smoke.js"
  },
  "dependencies": {
    "@electron/remote": "2.0.8",
    "@fortawesome/fontawesome-svg-core": "1.2.36",
    "@fortawesome/free-solid-svg-icons": "5.15.4",
    "@fortawesome/react-fontawesome": "0.1.18",
    "@fparchive/flashpoint-archive": "0.13.7",
    "@mdx-js/mdx": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@reduxjs/toolkit": "^2.2.6",
    "@types/node-7z": "2.1.8",
    "@types/react-virtualized": "^9.21.21",
    "axios": "1.6.7",
    "connected-react-router": "6.9.2",
    "dns-packet": "^5.6.1",
    "electron-extension-installer": "^1.2.0",
    "electron-updater": "4.3.1",
    "electron-util": "0.14.2",
    "fast-xml-parser": "3.21.1",
    "follow-redirects": "1.15.5",
    "fs-extra": "8.1.0",
    "lodash": "^4.17.21",
    "mime": "2.4.4",
    "minimist": "^1.2.7",
    "node-7z": "3.0.0",
    "open": "^10.1.0",
    "react": "17.0.2",
    "react-color": "2.18.0",
    "react-contenteditable": "^3.3.7",
    "react-datepicker": "4.8.0",
    "react-dom": "17.0.2",
    "react-error-boundary": "^5.0.0",
    "react-keybind": "0.10.0",
    "react-markdown": "7.0.1",
    "react-redux": "7.2.8",
    "react-router-dom": "5.1.2",
    "react-virtualized-reactv17": "9.23.0",
    "redux": "4.0.5",
    "redux-devtools-extension": "2.13.8",
    "reflect-metadata": "0.1.10",
    "remark-gfm": "2.0.0",
    "tail": "2.0.3",
    "terminate": "2.6.1",
    "tree-kill": "^1.2.2",
    "typesafe-actions": "4.4.2",
    "uuid": "3.3.2",
    "uuid-validate": "0.0.3",
    "which": "1.3.1",
    "ws": "8.18.0",
    "yaml": "2.4.1",
    "zod": "^3.22.2"
  },
  "optionalDependencies": {
    "fsevents": "2.1.3"
  }
}
