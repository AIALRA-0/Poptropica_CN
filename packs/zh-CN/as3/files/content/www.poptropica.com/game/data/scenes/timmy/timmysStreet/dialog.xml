<dialogs>
	<character id="timmy">
		<statement id="nefarious" link="trying_to_help" linkEntityId="corrina">终于让我抓到你的把柄了，你这个奸诈的骗子。</statement>
		<statement id="magistrate" link="good_luck" linkEntityId="corrina">留着跟法官说吧。你下半辈子都得戴着镣铐！</statement>
