<item id="geode">
	<type>island</type>
	<subType>arab3</subType>
	<textfields>
 		<text>
      		<value>晶洞岩</value>
    	</text>
  	</textfields>

	<assets>
  		<asset id="cardBack">
			<assetPath>items/arab3/background.swf</assetPath>
       		<effect>
      			<name>adjustColorFilter</name>
      			<enabled>true</enabled>
      			<brightness>0</brightness>
     			<contrast>0</contrast>
     			<saturation>0</saturation>
     			<hue>0</hue>
    		</effect>
    	</asset>
    	<asset id="cardContent"/>
    </assets>
    
   	<buttons>
  		<btn>
  			<label>使用</label>
			<actions>
	    		<action type="triggerEvent">
	    			<conditional id="inScene" isTrue="true"/>
		  			<parameters>
		  				<param id="event">use_geode</param>
					</parameters>
				</action>
				<action type="triggerEvent">
	    			<conditional id="inScene" isTrue="false"/>
		  			<parameters>
		  				<param id="event">cant_use_geode</param>
					</parameters>
				</action>
			</actions>
		</btn>
	</buttons>
    
     <conditionals>
    	<conditional type="inScene">
    		<parameters>
		  		<param id="validScenes">game.scenes.arab3.desert.Desert</param>
			</parameters>
    	</conditional>
    </conditionals>
	
</item>