<item id="dough"> <!-- Make sure the id name is the same as your .xml and the .swf art you want to load on the card -->
	<type>island</type>
	<subType>carnival</subType> <!-- Set subType to the location of card .swf art - bin/assets/items/"folder" -->

	<textfields>
  		<text>
    		<value>炸面团</value>
  		</text>
  	</textfields>

	<assets>
  		<asset id="cardBack">
			<assetPath>items/carnival/background.swf</assetPath>
			<!-- These effect settings change the color of the background card, you get the numbers from Flash's "Adjust Color" filter -->
			<effect>
      			<name>adjustColorFilter</name>
      			<enabled>true</enabled>
      			<brightness>0</brightness>
     			<contrast>0</contrast>
     			<saturation>-49</saturation>
     			<hue>-3</hue>
    			</effect>
	    	</asset>
	    	<asset id="cardContent"/>
    </assets>

	<buttons>
		<btn>
    		<label>使用</label>
    		<actions>
			
	    		<action type="triggerEvent">
					<conditional id="inScene" isTrue="true"/>
		  			<parameters>
		  				<param id="event">useDough</param>
					</parameters>
				</action>
				<action type="triggerEvent">
	    			<conditional id="inScene" isTrue="false"/>
		  			<parameters>
		  				<param id="event">no_reason_to_use_item_default</param>
					</parameters>
				</action>
				
			</actions>
  		</btn>
	</buttons>
	
	<conditionals>
    	<conditional type="inScene">
    		<parameters>
		  		<param id="validScenes">game.scenes.carnival.ringmastersTent.RingmastersTent</param>
			</parameters>
    	</conditional>
    </conditionals>
	
</item>