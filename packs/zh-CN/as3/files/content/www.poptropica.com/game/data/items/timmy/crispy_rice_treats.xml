<item id="crispy_rice_treats">
	<type>island</type>
	<subType>timmy</subType>

	<textfields>
  		<text>
    		<value>脆米点心</value>
		</text>
		<text id="islandgray">
			<conditional type="checkIfMobile" isTrue="false"></conditional>
			<value>按空格键投掷脆米点心！</value>
			<width>190</width>
  			<y>70</y>
		</text>
		<text id="islandgray">
			<conditional type="checkIfMobile" isTrue="true"></conditional>
			<value>按动作键投掷脆米点心！</value>
			<width>190</width>
  			<y>70</y>
		</text>
  	</textfields>

	<assets>
  		<asset id="cardBack">
			<effect>
      			<name>adjustColorFilter</name>
      			<enabled>true</enabled>
      			<brightness>0</brightness>
     			<contrast>0</contrast>
     			<saturation>-77</saturation>
     			<hue>-45</hue>
    			</effect>
	    	</asset>
	    	<asset id="cardContent"/>
    </assets>
	
	<!-- <buttons>
		<btn>
    		<label>USE</label>
