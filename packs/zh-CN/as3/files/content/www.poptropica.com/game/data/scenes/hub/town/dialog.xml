			<exchange>
				<question triggerEvent="triggerEvent" triggerEventArgs="said_more_to_adventure">当然想！</question>


						</exchange>
			<exchange>
				<question triggerEvent="triggerEvent" triggerEventArgs="no_to_adventure, true">现在不想。</question>
				<answer>如果你改变主意了，随时告诉我。</answer>



						</exchange>



				</conversation>
