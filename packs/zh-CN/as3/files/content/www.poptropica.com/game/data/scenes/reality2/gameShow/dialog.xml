<dialogs>
	<character id="probably">
		<statement id="eek">呀啊啊啊！</statement>
		<statement id="spiders">哈！蜘蛛。毛茸茸的小东西。</statement>
		<statement id="like">我挺喜欢它们。</statement>
		<statement id="choose">选择三名挑战者吧，我无畏的朋友。</statement>
		<statement id="chosen" link="confirm">挑战者已经选好了！你准备好了吗？</statement>
		<conversation id = "confirm">
			<exchange>
				<question forceOnScreen="true">我们来选新的挑战者。</question>
				<answer triggerEvent="triggerEvent" triggerEventArgs="repick">谨慎选择。</answer>
			</exchange>
			<exchange>
				<question forceOnScreen="true">我是新手。</question>
				<answer triggerEvent="triggerEvent" triggerEventArgs="difficulty_easy">明白。这些游戏会设为基础模式。</answer>
			</exchange>
			<exchange>
				<question forceOnScreen="true">准备大干一场！</question>
				<answer triggerEvent="triggerEvent" triggerEventArgs="difficulty_normal">听起来你很有信心。这场比赛一定很精彩！</answer>
			</exchange>
			<exchange>
				<question forceOnScreen="true" >看我称霸全场！</question>
				<answer triggerEvent="triggerEvent" triggerEventArgs="difficulty_hard">嚯嚯！有人很有自信嘛。你最好准备好迎接一生难忘的挑战！</answer>
			</exchange>
		</conversation>
		<statement id="begin" triggerEvent="triggerEvent" triggerEventArgs="games_started, true">嘻嘻！我激动得快喘不过气了！比赛开始！</statement>
		<statement id="winners">现在颁发第三名。如果我抬得起手，我一定向你敬礼。</statement>
		<statement id="second">第二名属于那位肱二头肌特别结实的人。你知道我说的是谁。</statement>
		<statement id="drum roll">疯狂敲响邦戈鼓，迎接我们的新岛屿冠军！！！第一名是……</statement>
		<statement id="congrats">祝贺我们的获胜者！</statement>
		<statement id="credits">至于你，[Player Name]，根据你的表现，你一共获得了……</statement>
		<statement id="uhoh" link = "save">糟了……如果你想获得这些点数，必须先保存游戏。</statement>
		<statement id="save" link = "response">你想先保存游戏，以便获得这些点数吗？</statement>
		<conversation id = "response">
			<exchange>
				<question>好的，谢谢。</question>
				<answer triggerEvent="triggerEvent" triggerEventArgs="save_game">很好！我这就为你安排！</answer>
			</exchange>
			<exchange>
				<question>不用了，谢谢。</question>
				<answer triggerEvent="triggerEvent" triggerEventArgs="continue_game">别担心。</answer>
			</exchange>
		</conversation>
		<statement id="splendid">太棒了，按约定，这是你的点数。</statement>
		<statement id="next">开始下一项挑战！</statement>
		<statement id="final" triggerEvent="triggerEvent" triggerEventArgs="competition_finished, true">节目到这里就结束了！感谢小蛇全程抱着我，这种尴尬真是妙不可言。下次再来！！！</statement>
    </character>
