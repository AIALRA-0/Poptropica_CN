						</exchange>
			<exchange>
				<question triggerEvent="triggerEvent" triggerEventArgs="wish_animals">我想要能和动物说话。</question>


						</exchange>
			<exchange>
				<question triggerEvent="triggerEvent" triggerEventArgs="wish_banjo">我想成为世界第一的班卓琴手。</question>


						</exchange>




				</conversation>















		</character>
	<character id="old">
