<item id="axe">
	<type>island</type>
	<subType>mocktropica</subType>
	
	<textfields>
  		<text>
    		<value>登山斧</value>
  		</text>
  	</textfields>
	
	<assets>
  		<asset id="cardBack">
       		<effect>
      			<name>adjustColorFilter</name>
      			<enabled>true</enabled>
      			<brightness>0</brightness>
     			<contrast>0</contrast>
     			<saturation>-81</saturation>
     			<hue>-158</hue>
    			</effect>
	    	</asset>
	    	<asset id="cardContent"/>
    </assets>

	<buttons>
		<btn>
    		<label>使用</label>
    		<actions>
	    		<action type="triggerEvent">
	    			<conditional id="inScene" isTrue="true"/>
		  			<parameters>
		  				<param id="event">axe_used</param>
					</parameters>
				</action>
				<action type="triggerEvent">
	    			<conditional id="inScene" isTrue="false"/>
		  			<parameters>
		  				<param id="event">wrong_axe_use</param>
					</parameters>
				</action>
			</actions>
  		</btn>
	</buttons>
	
	<conditionals>
    	<conditional type="inScene">
    		<parameters>
		  		<param id="validScenes">game.scenes.mocktropica.cheeseInterior.CheeseInterior</param>
			</parameters>
    	</conditional>
    </conditionals>
	
</item>