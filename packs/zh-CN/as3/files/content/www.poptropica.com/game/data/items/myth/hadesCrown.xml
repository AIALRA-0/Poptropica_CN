<item id="hadesCrown">
  	<type>island</type>
  	<subType>myth</subType>
  	<buttons>
    	<btn>
			<conditional id="hasLook" isTrue="false"/>
    		<label>穿上</label>
    		<actions>
				<action type="applyLook"/>
			</actions>
  		</btn>
  		<btn>
			<conditional id="hasLook" isTrue="true"/>
    		<label>脱下</label>
    		<actions>
    			<action type="removeLook"/>
				<action type="applyLook">	
					<parameters>
						<param id="useLook">1</param>
						<param id="perm">true</param>
					</parameters>
				</action>
			</actions>
  		</btn>
  	</buttons>
  	<textfields>
 		<text>
      		<value>哈迪斯的王冠</value>
    	</text>
    	
    	<text>
  			<conditional id="checkIfMobile" isTrue="false"></conditional>
      		<value>按空格键释放力量！</value>
      		<size>18</size>
      		<y>90</y>
      		<width>150</width>
      		<textColor>0x40493E</textColor>
    	</text>
    	<text>
  			<conditional id="checkIfMobile" isTrue="true"></conditional>
      		<value>点按动作按钮释放力量！</value>
      		<size>18</size>
      		<y>70</y>
      		<width>150</width>
      		<textColor>0x40493E</textColor>
    	</text>
    	
 
  	</textfields>
	<assets>
  		<asset id="cardBack">
  			<assetPath>items/myth/background_star.swf</assetPath>
       		<effect>
      			<name>adjustColorFilter</name>
      			<enabled>true</enabled>
      			<brightness>0</brightness>
     			<contrast>0</contrast>
     			<saturation>-37</saturation>
     			<hue>65</hue>
    		</effect>
    	</asset>
   		<asset id="cardContent"/>
    </assets>
    
    <looks>
	    <look>
		 	<hair>hades</hair>
	   	</look> 
	   	<look>
	   		<hair>hades2</hair>
	   	</look>
	</looks> 
	
    <conditionals>
    	<conditional type="hasLook">
    		<parameters>
				<param id="lookId"/>
			</parameters>
		</conditional>	<!-- if no lookId param is given uses first look by default -->
		<conditional type="checkIfMobile">
		
		</conditional>
    </conditionals>
</item>