<item id="bonbons">
	<type>island</type>
	<subType>timmy</subType>

	<textfields>
  		<text>
    		<value>夹心糖果</value>
		</text>
		<text id="islandgray">
			<conditional type="checkIfMobile" isTrue="false"></conditional>
			<value>按空格键投掷夹心糖果！</value>
			<width>190</width>
  			<y>88</y>
		</text>
		<text id="islandgray">
			<conditional type="checkIfMobile" isTrue="true"></conditional>
			<value>按动作键投掷夹心糖果！</value>
			<width>190</width>
  			<y>88</y>
		</text>
  	</textfields>

	<assets>
  		<asset id="cardBack">
			<effect>
      			<name>adjustColorFilter</name>
      			<enabled>true</enabled>
      			<brightness>0</brightness>
     			<contrast>0</contrast>
     			<saturation>-77</saturation>
     			<hue>-45</hue>
    			</effect>
	    	</asset>
	    	<asset id="cardContent"/>
    </assets>
	
	<buttons>
		<btn>
			<conditional id="hasLook" isTrue="false"></conditional>
			<label>装备</label>
    		<actions>
	    		<action type="applyLook"/>
			</actions>
  		</btn>
  		<btn>
			<conditional id="hasLook" isTrue="true"></conditional>
    		<label>移除</label>
    		<actions>
	    		<action type="removeLook"/>
			</actions>
  		</btn>
	</buttons>
	
	<conditionals>
		<conditional type="hasLook"/>
		<conditional type="checkIfMobile"/>
	</conditionals>
	
	<looks>
		<look>
			<item>bonbons</item>
		</look>
	</looks>
</item>