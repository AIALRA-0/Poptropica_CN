<item id="car_key">
	<type>island</type>
	<subType>timmy</subType>

	<textfields>
  		<text>
    		<value>克里斯平·弗拉维乌斯的车钥匙</value>
		</text>
  	</textfields>

	<assets>
  		<asset id="cardBack">
			<effect>
      			<name>adjustColorFilter</name>
      			<enabled>true</enabled>
      			<brightness>0</brightness>
     			<contrast>0</contrast>
     			<saturation>-50</saturation>
     			<hue>-20</hue>
    			</effect>
	    	</asset>
	    <asset id="cardContent"/>
    </assets>
    
	<buttons>
		<btn>
    		<label>使用</label>
    		<actions>
	    		<action type="triggerEvent">
	    			<conditional id="inScene" isTrue="true"/>
		  			<parameters>
		  				<param id="event">use_car_keys</param>
					</parameters>
				</action>
				<action type="triggerEvent">
	    			<conditional id="inScene" isTrue="false"/>
		  			<parameters>
		  				<param id="event">cant_use_car_keys</param>
					</parameters>
				</action>
			</actions>
  		</btn>
	</buttons>
	
	<conditionals>
    	<conditional type="inScene">
    		<parameters>
		  		<param id="validScenes">game.scenes.timmy.mainStreet.MainStreet</param>
			</parameters>
    	</conditional>
    </conditionals>	
</item>