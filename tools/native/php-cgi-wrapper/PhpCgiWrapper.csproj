<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Use the runtime available on the QA host.  The wrapper is a
         WinExe so CGI worker processes never create visible console
         windows when Flashpoint invokes them. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>php-cgi</AssemblyName>
    <RootNamespace>PhpCgiWrapper</RootNamespace>
  </PropertyGroup>
</Project>
